# mock -> PIL placeholder (default; boots with no GPU, used by tests/CI)
# real -> SAM2 + SDXL-inpaint + ControlNet (needs a CUDA GPU or Colab)
PIPELINE_MODE=mock
DEVICE=cuda

# --- SAM2 ---
SAM2_MODEL_SIZE=small
SAM2_CHECKPOINT_PATH=/models/sam2.1_hiera_small.pt
SAM2_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_s.yaml

# --- SDXL inpainting + ControlNet ---
SDXL_INPAINT_MODEL_ID=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
CONTROLNET_TYPE=canny
CONTROLNET_CANNY_MODEL_ID=diffusers/controlnet-canny-sdxl-1.0
CONTROLNET_DEPTH_MODEL_ID=diffusers/controlnet-depth-sdxl-1.0
SDXL_STEPS=25
SDXL_GUIDANCE_SCALE=7.0
SDXL_CONTROLNET_SCALE=0.55
# set true for <12GB VRAM (sequential CPU offload + VAE tiling; slow but fits)
LOW_VRAM=false
